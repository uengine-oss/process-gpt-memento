SUPABASE_URL=
SUPABASE_KEY=

# openai | openrouter | custom
MEMENTO_LLM_PROVIDER=openai
MEMENTO_EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_EMBEDDING_API_KEY=

# custom provider only
CUSTOM_LLM_BASE_URL=
CUSTOM_EMBEDDING_BASE_URL=

MEMENTO_TRACEMALLOC=0

# PDF 이미지 추출 + 비전 분석 on/off (true|false).
MEMENTO_IMAGE_ANALYSIS=

# ── Chroma 벡터DB 모드 ──
# 미설정(빈 값): in-process PersistentClient (기존 동작, chroma_persist_directory 사용).
# 설정 시: 별도 Chroma 서버(HttpClient)에 접속 → 대용량 인덱스가 API 프로세스를 얼리는 문제 해소.
#   서버 구성은 ../process-gpt-chroma (docker compose) 참고. 이미지 버전은 이 lib(chromadb)와 일치시킬 것.
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000

# ── 벡터 인덱스 백엔드 ──
# chroma (기본) | qdrant
# Chroma 는 HNSW 그래프와 원본 벡터를 전부 RAM 에 상주시킨다. 인덱스가 수십 GB 가 되면
# 그대로 메모리 압박이 되므로, 대용량 환경은 qdrant 를 쓴다.
# 이관: python scripts/migrate_chroma_to_qdrant.py (재임베딩 없음, 재개 가능)
VECTOR_BACKEND=chroma

# ── Qdrant (VECTOR_BACKEND=qdrant 일 때) ──
# 서버 구성은 ../process-gpt-qdrant (docker compose). 서버와 qdrant-client 의 major/minor 를 맞출 것.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_URL=            # 지정 시 HOST/PORT 대신 이 값을 쓴다
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=1536

# 메모리 설계 스위치 — 이 세 개가 Chroma 대비 상주 메모리를 줄이는 실체다.
#   QDRANT_ON_DISK=true       원본 벡터/HNSW/payload 를 디스크(mmap)에. 랜덤 리드가 늘어나므로
#                             스토리지가 NVMe 가 아니면 false 를 검토할 것.
#   QDRANT_QUANTIZATION=int8  RAM 에는 int8 양자화본만(벡터당 1/4 크기). binary 는 1/32 지만
#                             oversampling 을 크게 줘야 하고 정확도 손실이 크다. none 은 양자화 없음.
#   QDRANT_SEARCH_OVERSAMPLING 양자화본으로 후보를 몇 배 넓게 뽑아 원본으로 재채점할지.
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION=int8
QDRANT_SEARCH_OVERSAMPLING=2.0
# 검색 탐색 폭. Chroma 의 ef_search=100 과 맞춰둔 값 — 리콜이 아쉬우면 키운다(지연 증가).
QDRANT_HNSW_EF=100
