# memento 설정. cp .env.example .env 후 채운다. 전체 목록·기본값·뜻: docs/specs/configuration.md
# 비어 있으면 기본값이다. 비밀값(키)은 커밋하지 않는다.

# ── 필수 ──
SUPABASE_URL=
SUPABASE_KEY=

# ── LLM: 카드·섹션·그림 설명·OCR·표 파싱 ──
# openai(OpenAI 호환: OpenAI·litellm 프록시) | openrouter | custom(vLLM 등 자체 서버)
MEMENTO_LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_LLM_BASE_URL=          # litellm 프록시 등. 비우면 api.openai.com
# OPENAI_LLM_MODEL=
OPENROUTER_API_KEY=
# OPENROUTER_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=
# CUSTOM_LLM_DISABLE_THINKING=true

# ── 임베딩 ── openai | openrouter | custom | self
MEMENTO_EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=
CUSTOM_EMBEDDING_BASE_URL=
CUSTOM_EMBEDDING_API_KEY=
# CUSTOM_EMBEDDING_MODEL=

# ── PDF 파서 ──
# PDF 표를 LLM(그림 + 그 영역 글자)으로 다시 읽는다. 표마다 10초 안팎이라 기본 끔.
# 켜거나 모델을 바꾸면 python -m scripts.reindex_stale <tenant> --ext pdf
MEMENTO_TABLE_LLM=false
# MEMENTO_TABLE_LLM_PROVIDER=   # 비우면 MEMENTO_LLM_PROVIDER
# MEMENTO_TABLE_LLM_MODEL=      # 비우면 그 프로바이더의 모델. 그림을 받는 모델이어야 한다
# MEMENTO_PDF_VISION_WORKERS=4  # 그림 설명·OCR·표 파싱 동시 호출 수
# MEMENTO_IMAGE_ANALYSIS=       # 추출 이미지 재분석. 비우면 프로바이더가 그림을 받을 때 켬

# ── 벡터 인덱스 ── chroma(기본) | qdrant(대용량: 이관은 scripts/migrate_chroma_to_qdrant.py)
VECTOR_BACKEND=chroma
# 비우면 프로세스 안 Chroma, 주면 Chroma 서버(../process-gpt-chroma). 서버와 chromadb 버전을 맞출 것
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000

# Qdrant(VECTOR_BACKEND=qdrant): 서버는 ../process-gpt-qdrant. 서버와 qdrant-client 의 major/minor 를 맞출 것
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_URL=                   # 주면 HOST/PORT 대신
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=1536
# 상주 메모리를 줄이는 세 값: 디스크(mmap) 저장, int8 양자화, 양자화 후보를 몇 배로 뽑아 재채점.
# 스토리지가 NVMe 가 아니면 QDRANT_ON_DISK=false 를 검토한다.
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION=int8
QDRANT_SEARCH_OVERSAMPLING=2.0
QDRANT_HNSW_EF=100

# ── 그 밖에 자주 만지는 값 (나머지는 docs/specs/configuration.md) ──
# MEMENTO_INGEST_CONCURRENCY=4
# MEMENTO_INGEST_JOB_TIMEOUT=900
# HWPX_RHWP=                    # rhwp 실행 파일. 비우면 PATH
MEMENTO_TRACEMALLOC=0
