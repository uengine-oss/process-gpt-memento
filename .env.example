# memento 설정. cp .env.example .env 후 채운다. 전체 목록·기본값·뜻: docs/specs/configuration.md
# 비어 있으면 기본값이다. 비밀값(키)은 커밋하지 않는다.

# ── 필수 ──
SUPABASE_URL=
SUPABASE_KEY=

# ── LLM: 카드·섹션·그림 설명·OCR·표 파싱 ──
# openai(OpenAI·litellm 프록시) | openrouter | custom(vLLM 등 자체 서버). 주소·모델을 비우면 프로바이더 기본값
MEMENTO_LLM_PROVIDER=openai
MEMENTO_LLM_BASE_URL=
MEMENTO_LLM_API_KEY=
MEMENTO_LLM_MODEL=

# ── 임베딩 ── openai | openrouter | custom | self
MEMENTO_EMBEDDING_PROVIDER=openai
MEMENTO_EMBEDDING_BASE_URL=
MEMENTO_EMBEDDING_API_KEY=
MEMENTO_EMBEDDING_MODEL=
# MEMENTO_EMBEDDING_BATCH_SIZE=8      # 임베딩 서버 한도에 맞춘다
# MEMENTO_EMBEDDING_DEVICE=cuda       # self 일 때

# ── PDF 파서 ──
# PDF 표를 LLM(그림 + 그 영역 글자)으로 다시 읽는다. 표마다 10초 안팎이라 기본 끔.
# 켜거나 모델을 바꾸면 python -m scripts.reindex_stale <tenant> --ext pdf
MEMENTO_TABLE_LLM=false
# MEMENTO_TABLE_LLM_MODEL=            # 비우면 MEMENTO_LLM_MODEL. 그림을 받는 모델이어야 한다
# MEMENTO_PDF_VISION_WORKERS=4        # 한 문서의 그림 설명·OCR·표 파싱 동시 호출 수
# MEMENTO_IMAGE_ANALYSIS=             # 추출 이미지 재분석. 비우면 프로바이더가 그림을 받을 때 켬

# ── 벡터 인덱스 ── chroma(기본) | qdrant(대용량)
VECTOR_BACKEND=chroma
# 비우면 프로세스 안 Chroma, 주면 Chroma 서버(../process-gpt-chroma). 서버와 chromadb 버전을 맞출 것
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000
# Qdrant(VECTOR_BACKEND=qdrant): 서버는 ../process-gpt-qdrant. 서버와 qdrant-client 의 major/minor 를 맞출 것
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_URL=                         # 주면 HOST/PORT 대신
# QDRANT_API_KEY=
# 임베딩 차원 / 디스크(mmap) 저장 — 스토리지가 NVMe 가 아니면 false 를 검토
QDRANT_VECTOR_SIZE=1536
QDRANT_ON_DISK=true

# ── 인제스트 ──
# MEMENTO_INGEST_CONCURRENCY=4
# MEMENTO_INGEST_MAX_CONCURRENCY=12
# MEMENTO_INGEST_JOB_TIMEOUT=900
# HWPX_RHWP=                          # rhwp 실행 파일. 비우면 PATH
